    ]
  },
  "known_deviation_from_json_era": {
    "field": "vigor",
    "json_era": "int (json.dump/json.load preserved Python's int verbatim)",
    "markdown_era": "str (e.g. 9 -> '9')",
    "scope": "PERSISTENCE ONLY. parse_observation() still yields an int and update_plant() still assigns that int to plant['vigor'] in memory -- byte-identical logic to the JSON era. The type changes on the round-trip through plants/<ID>.md.",
    "cause": "Phase 1's canonical, Joey-approved plant-template.md declares vigor as a free-text STRING ('strong'/'weak'/'average'), not an integer. breeding-markdown/DECISIONS.md records that an integer vigor was explicitly REVERTED as an unapproved schema change (vigor is null on all 95 real plants). The schema-typed read therefore coerces 9 -> '9'.",
    "why_not_fixed_here": "Making vigor survive as an int would require editing breeding-markdown's approved schema, which Task 2.2 is explicitly forbidden to modify, and would re-introduce the exact change Phase 1's review reverted. The parsing/status-detection contract this task exists to protect is unaffected: plant['status'] is identical under both backends for all three status keywords.",
    "real_world_impact": "Nil on current data (vigor is null on all 95 real plants); vigor has never been populated in production. Flagged for a product decision, not silently accepted.",
    "keys": "Cases carrying this deviation record the pre-migration value under 'plant_after_json_era' and set 'vigor_type_deviation': true."
  }
}